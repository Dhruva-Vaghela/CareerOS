# ==============================================================================
# CareerOS Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (MongoDB Atlas)
# ------------------------------------------------------------------------------
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/careeros?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Authentication & JWT Configuration
# ------------------------------------------------------------------------------
PORT=3001
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Google OAuth 2.0 (Google Cloud Console credentials)
# Authorized JavaScript Origins:
#   http://localhost:5173
#   http://localhost:3001
# Authorized Redirect URIs:
#   http://localhost:3001/api/v1/auth/google/callback
#   http://localhost:5173/api/v1/auth/google/callback
#   http://localhost:5173/auth/google/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# GitHub OAuth (Project Intelligence integration)
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5173/auth/github/callback

# ------------------------------------------------------------------------------
# Cloudinary (Resume & Asset Storage)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# AI Provider Configuration
# ------------------------------------------------------------------------------
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
AI_DEFAULT_MODEL=llama-3.3-70b-versatile
AI_FAST_MODEL=llama-3.1-8b-instant
AI_FALLBACK_MODEL=llama-3.1-8b-instant
AI_TEMPERATURE=0.7
AI_TOP_P=0.9
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=60000
AI_LOG_REQUESTS=true
AI_LOG_RESPONSES=true

# ------------------------------------------------------------------------------
# Voice Services (Sarvam AI)
# ------------------------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key
