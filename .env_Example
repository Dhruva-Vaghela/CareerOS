DATABASE_URL=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority

# Optional: Custom DNS servers (comma-separated list of IP addresses)
# Useful if Node's DNS resolution fails with ECONNREFUSED on querySrv due to local network or VPN resolver limitations.
# DNS_SERVERS=1.1.1.1,8.8.8.8
# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key
# R2_SECRET_ACCESS_KEY=your_secret_key
# R2_BUCKET_NAME=your_bucket_name
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloud_key
CLOUDINARY_API_SECRET=your_secret_key
# AI Provider
AI_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=your_gemini_api_key

# Model Configuration
AI_DEFAULT_MODEL=your_default_gemini_model
AI_FALLBACK_MODEL=your_reasoning_or_fallback_gemini_model

AI_MAX_OUTPUT_TOKENS=8192
AI_TEMPERATURE=0.3
AI_TOP_P=0.95
AI_TOP_K=40

# Retry
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=60000

# Cache
AI_CACHE_ENABLED=true
AI_CACHE_TTL=3600

# Logging
AI_LOG_REQUESTS=true
AI_LOG_RESPONSES=false

# Telemetry
AI_TRACK_COST=true
AI_TRACK_TOKENS=true