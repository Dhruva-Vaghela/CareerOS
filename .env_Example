# Database

# MongoDB Atlas connection string
# Replace:
#   <username> with your database username
#   <password> with your database password
#   <cluster-url> with your MongoDB cluster URL
#   <database-name> with your database name
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority


# Cloudinary (File Storage)
# Get these values from:
# https://console.cloudinary.com/

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# Cloudflare R2 (Optional)
# Uncomment and configure only if using R2 instead of Cloudinary

# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key
# R2_SECRET_ACCESS_KEY=your_secret_key
# R2_BUCKET_NAME=your_bucket_name
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com


# AI Provider Foundation
# Provider-neutral model aliases are resolved by @careeros/ai-client; do not use
# provider model names in business services.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
AI_DEFAULT_MODEL=your_default_gemini_model
AI_FAST_MODEL=your_fast_gemini_model
AI_FALLBACK_MODEL=your_reasoning_or_fallback_gemini_model
AI_TEMPERATURE=0.2
AI_TOP_P=0.9
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_RETRIES=1
AI_TIMEOUT_MS=30000
AI_LOG_REQUESTS=false
AI_LOG_RESPONSES=false
